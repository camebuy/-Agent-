# Copy to .env and fill in your own key. Do not commit the completed .env.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
MODEL_NAME=deepseek-ai/DeepSeek-V3
EMBED_MODEL=BAAI/bge-small-zh-v1.5

# Kimi WebBridge daemon in the same interactive Windows session.
KIMI_WEBBRIDGE_HOST=127.0.0.1
KIMI_WEBBRIDGE_PORT=10086
KIMI_WEBBRIDGE_SESSION=aacwork-agent
KIMI_WEBBRIDGE_TIMEOUT=30

# Optional runtime limits.
AACWORK_MAX_ITERATIONS=20
AACWORK_FUNCTION_CALLING=false
# AACWORK_DATA_DIR=C:\path\to\private-data
